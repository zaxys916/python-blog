---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 用于上下篇
const allPosts = await getCollection('blog').then(posts =>
  posts.sort((a, b) =>
    (b.data.date ?? '0').localeCompare(a.data.date ?? '0')
  )
);

const currentIndex = allPosts.findIndex(p => p.slug === post.slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<Layout title={post.data.title}>
  <article>
    <header
      style={{
        marginBottom: '2rem',
        paddingBottom: '1.5rem',
        borderBottom: '1px solid #eee',
      }}
    >
      <h1 style={{ margin: 0, color: '#2c3e50' }}>
        {post.data.title}
      </h1>

      <div
        style={{
          marginTop: '0.5rem',
          color: '#666',
          fontSize: '0.9rem',
        }}
      >
        {post.data.date
          ? post.data.date.toLocaleDateString('zh-CN')
          : '刚刚'}
        {post.data.tags && (
          <>
            {' • '}
            {post.data.tags.map(tag => (
              <span
                style={{
                  background: '#e3f2fd',
                  color: '#1565c0',
                  padding: '0.2rem 0.6rem',
                  borderRadius: '4px',
                  fontSize: '0.8rem',
                  margin: '0 0.2rem',
                }}
              >
                {tag}
              </span>
            ))}
          </>
        )}
      </div>
    </header>

    <Content />

    <!-- Giscus -->
    <section id="comments" style={{ marginTop: '3rem' }}>
      <script
        src="https://giscus.app/client.js"
        data-repo="zaxys916/python-blog"
        data-repo-id="R_kgDOSIpxJQ"
        data-category="General"
        data-category-id="DIC_kwDOSIpxJc4C7W_W"
        data-mapping="pathname"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        async
      ></script>
    </section>
  </article>

  <!-- 上一篇 / 下一篇 -->
  <nav
    style={{
      marginTop: '3rem',
      display: 'flex',
      gap: '2rem',
      paddingTop: '1.5rem',
      borderTop: '1px solid #eee',
    }}
  >
    {prevPost && (
      <div style={{ flex: 1 }}>
        <p style={{ margin: 0, color: '#2c3e50' }}>上一篇</p>
        <a
          href={`/blog/${prevPost.slug}`}
          style={{ color: '#2980b9', textDecoration: 'none' }}
        >
          {prevPost.data.title}
        </a>
      </div>
    )}

    {nextPost && (
      <div style={{ flex: 1, textAlign: 'right' }}>
        <p style={{ margin: 0, color: '#2c3e50' }}>下一篇</p>
        <a
          href={`/blog/${nextPost.slug}`}
          style={{ color: '#2980b9', textDecoration: 'none' }}
        >
          {nextPost.data.title}
        </a>
      </div>
    )}
  </nav>
</Layout>
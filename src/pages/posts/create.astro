---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('blog');

// 生成 slug
let slug = 'your-article-slug'; // TODO: 从 URL 解析或手动输入
if (!slug) slug = new URL(Astro.url).pathname.replace(/^\//, '').replace(/\/$/, '');

// 确保没有冲突的 slug
const existing = posts.find(p => p.slug === slug);
if (existing) {
    Astro.render.redirect(`/blog/${existing.slug}`, true);
}
---

<Layout title="发布新文章">
    <article>
        <h1 style="margin:0 0 1rem;color:#2c3e50;font-size:2rem">发布新文章</h1>

        <div style="background:#fff8dc;border-left:4px solid #ffcba4;padding:1rem;margin-bottom:2rem">
            <p style="margin:0;color:#666;font-size:0.9rem">
                发布文章后，文件将保存在 <code style="background:#f5f5f5;padding:0.2rem 0.4rem;border-radius:3px;font-family:monospace">src/content/blog/{slug}/</code> 目录中。
            </p>
        </div>

        <form id="post-form" style="display:flex;flex-direction:column;gap:1rem">
            <div>
                <label for="title" style="display:block;margin-bottom:0.3rem;font-weight:600">文章标题</label>
                <input type="text" id="title" name="title" required placeholder="输入文章标题..." style="width:100%;padding:0.7rem;border:1px solid #ddd;border-radius:4px;font-size:1rem">
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                <div>
                    <label for="slug" style="display:block;margin-bottom:0.3rem;font-weight:600">文章链接 (slug)</label>
                    <input type="text" id="slug" name="slug" value={slug} placeholder="我的-文章-标题" style="width:100%;padding:0.7rem;border:1px solid #ddd;border-radius:4px;font-size:0.9rem">
                    <small style="color:#666;display:block;margin-top:0.3rem">用于 URL 路径，用小写字母和下划线</small>
                </div>

                <div>
                    <label for="date" style="display:block;margin-bottom:0.3rem;font-weight:600">发布日期</label>
                    <input type="date" id="date" name="date" value={new Date().toISOString().split('T')[0]} style="width:100%;padding:0.7rem;border:1px solid #ddd;border-radius:4px;font-size:0.9rem">
                </div>
            </div>

            <div>
                <label for="content" style="display:block;margin-bottom:0.3rem;font-weight:600">文章内容</label>
                <textarea id="content" name="content" rows="12" required placeholder="# 文章标题&#10;&#10;这是文章内容...&#10;&#10;## 子标题&#10;&#10;- 列表项 1&#10;- 列表项 2" style="width:100%;padding:0.7rem;border:1px solid #ddd;border-radius:4px;font-size:1rem;font-family:inherit;resize:vertical"></textarea>
                <small style="color:#666;display:block;margin-top:0.3rem">支持 Markdown 语法，图片路径示例：![[images/demo.png]]</small>
            </div>

            <div style="display:flex;gap:1rem">
                <button type="submit" style="flex:1;padding:0.7rem;background:#2c3e50;color:#fff;border:none;border-radius:4px;font-size:1rem;font-weight:600 cursor:pointer">发布文章</button>
                <a href="/blog" style="padding:0.7rem 1rem;text-decoration:none;color:#666;background:#eee;border-radius:4px;text-align:center">取消</a>
            </div>
        </form>

        <div style="margin-top:2rem;padding:1rem;background:#f8f9fa;border-radius:4px;font-size:0.85rem;color:#666">
            <p><strong>💡 提示：</strong>发布后文件会保存在 <code>src/content/blog/{slug}/</code> 目录下，包含 <code>index.md</code> 和 <code>_data.json</code> 两个文件。</p>
        </div>
    </article>
</Layout>

<!-- 正确的表单提交方式 -->
<script>
document.getElementById('post-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  
  // ✅ 调用后端 API，而不是直接 fs.writeFile
  const res = await fetch('/api/create', {
    method: 'POST',
    body: formData
  });

  if (res.ok) {
    window.location.href = '/blog';
  }
});
</script>

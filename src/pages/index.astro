---
// 首页
import BlogList from '../components/BlogList.astro';
---

<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Python 学习笔记</title>
</head>
<body style="margin:0;font-family:'Segoe UI',system-ui,sans-serif">
    <div class="container" style="max-width:800px;margin:0 auto;padding:2rem;">
        <header style="text-align:center;margin-bottom:3rem;">
            <h1 style="margin:0;color:#2c3e50;font-size:2.5rem">Python 学习笔记</h1>
            <p style="color:#666;margin-top:0.5rem">记录 Python 学习过程中的技术与思考</p>
        </header>

        <BlogList />

        <footer style="margin-top:4rem;text-align:center;color:#999;font-size:0.9rem">
            <p>部署到 GitHub Pages | 使用 Astro + Giscus 评论</p>
        </footer>
    </div>
</body>
</html>

---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
---

<article class="article" style="padding:1.5rem;background:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.06);border:1px solid #eee">
    <time datetime={date?.toISOString() || new Date().toISOString()} style="color:#999;font-size:0.8rem;margin-bottom:1rem">{date?.toLocaleDateString('zh-CN') || '刚刚'}</time>
    <h2 style="margin:0 0 0.5rem;color:#2c3e50">{title}</h2>
    <slot />
</article>
